NEXT_PUBLIC_SITE_URL=https://hojucompass.com

# Search engine ownership verification. Paste only the content value supplied
# by each webmaster tool; these values are public verification tokens.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
NAVER_SITE_VERIFICATION=

# Payments remain off until identity, bank, legal copy, refunds and access control are ready.
PAYMENTS_ENABLED=false
# Prefer a least-privilege Stripe restricted key (rk_test_ / rk_live_) over a full secret key.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_RESUME_PRO_PRICE_ID=
# Independent Product ID prevents a same-price Product from being sold by mistake.
STRIPE_RESUME_PRO_PRODUCT_ID=
# Exact Dashboard-approved Product tax code labelled eligible for Managed Payments.
# Treat txcd_ identifiers as opaque: copy one exactly; never infer or guess it.
STRIPE_RESUME_PRO_TAX_CODE=
STRIPE_MANAGED_PAYMENTS_ENABLED=true
PAYMENTS_ENTITLEMENT_STORE=
# Manual connection override. Vercel's managed Neon integration supplies
# ENTITLEMENT_DB_DATABASE_URL instead, which the app also recognises.
ENTITLEMENT_DB_URL=
# Reserved for privacy-preserving email lookup when purchase restoration is enabled.
ENTITLEMENT_DB_HMAC_SECRET=
# At least 32 random characters. Used only to sign HttpOnly Pro access cookies.
ENTITLEMENT_SESSION_SECRET=

# Public Hoju Compass product-provider details shown on the purchase-information page.
# These values do not configure or prove the Managed Payments transaction seller;
# verify that role from the actual Checkout and issued receipt/invoice.
# Optional trading-name override; the registered site name "Hoju Compass" is the default.
BUSINESS_TRADING_NAME=
# Legal/registered name of the Hoju Compass product provider, not a Merchant of Record override.
BUSINESS_LEGAL_NAME=
BUSINESS_ABN=
NEXT_PUBLIC_SUPPORT_EMAIL=

# Private operator alerts for paid Pro purchases, refunds and disputes.
# Generate a dedicated Zoho application-specific password; never use the mailbox password.
PAYMENT_ALERTS_ENABLED=false
PAYMENT_ALERT_TO_EMAIL=support@hojucompass.com
PAYMENT_ALERT_FROM_EMAIL=support@hojucompass.com
ZOHO_SMTP_HOST=smtppro.zoho.com
ZOHO_SMTP_PORT=465
ZOHO_SMTP_USER=support@hojucompass.com
ZOHO_SMTP_APP_PASSWORD=

# Local-only bookkeeping export. Use a separate read-only restricted key and
# never add this variable to the public site or commit its value.
STRIPE_ACCOUNTING_KEY=
